# AWS credentials come from a named profile (aws login --profile <name>).
# Never put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in this file.
AWS_PROFILE=your-profile-name

# Singapore, for data residency (Bedrock and Textract both use it)
AWS_REGION=ap-southeast-1

# Bedrock model ID. Needs the Anthropic use-case form submitted once per
# account. "global." profiles may process requests outside Singapore (fine for
# synthetic data). anthropic.claude-sonnet-5 runs in ap-southeast-1 itself but
# is gated for new accounts (AWS Sales).
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Extraction mode: "stub" (deterministic, no AWS) or "llm" (calls Bedrock)
EXTRACTION_MODE=stub

# Set to true to OCR every page with AWS Textract: reads scans, and compares
# the text layer with what a reader sees (FORENSIC_OCR_MISMATCH)
OCR_ENABLED=false
# Concurrent Textract calls: keep at or below your DetectDocumentText quota (1/s by default, 10/s in ap-southeast-1 here)
OCR_MAX_WORKERS=5

# Set to true to run the AI agent team on Bedrock (a Supervisor plus four
# specialists; their leads never change the score or the route)
AGENTS_ENABLED=false
AGENT_SUPERVISOR_MODEL=global.anthropic.claude-sonnet-4-6
AGENT_SPECIALIST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Shadow case scorer: a model proposes a route for each case, logged beside the rule route and never used by
# it. Needs AGENTS_ENABLED; defaults to on with it. Reads structured case data only, so a small model will do.
SHADOW_SCORE_ENABLED=true
SHADOW_SCORER_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# ACRA and IRAS records, fetched per case from the mock service (uvicorn mock_gov.app:app --port 8001)
OFFICIAL_RECORDS_ENABLED=true
OFFICIAL_RECORDS_URL=http://127.0.0.1:8001

# Audit log paths
AUDIT_LOG_PATH=logs/audit_log.jsonl
USAGE_LOG_PATH=logs/usage.jsonl

# Set to 1 to allow tests to make live AWS calls (not recommended in CI)
RUN_LIVE=0

# Prompt attack screen (Bedrock Guardrails). Deploy infra/guardrail.yaml with
# CloudFormation, then copy the stack outputs GuardrailId and GuardrailVersion.
PROMPT_SCREEN_ENABLED=false
GUARDRAIL_ID=
GUARDRAIL_VERSION=
