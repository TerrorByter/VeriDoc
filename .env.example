# AWS credentials (never commit this file)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS region for Bedrock
# NOTE: Recent Claude models (claude-3-5-sonnet-v2, claude-3-7-sonnet, etc.) in
# ap-southeast-1 may require a global cross-region inference profile ID rather
# than the direct model ID. Use the inference profile ARN from the Bedrock console
# if you receive a ValidationException about model availability.
AWS_REGION=ap-southeast-1

# Bedrock model ID or cross-region inference profile ARN
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Extraction mode: "stub" (deterministic, no AWS) or "llm" (calls Bedrock)
EXTRACTION_MODE=stub

# Set to true to OCR scanned PDFs (no text layer) with AWS Textract
OCR_ENABLED=false

# Set to true to enable LLM plain-English explanation step
EXPLAIN_ENABLED=false

# Audit log paths
AUDIT_LOG_PATH=logs/audit_log.jsonl
LLM_USAGE_LOG_PATH=logs/llm_usage.jsonl

# Set to 1 to allow tests to make live AWS calls (not recommended in CI)
RUN_LIVE=0
